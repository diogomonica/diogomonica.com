---
import Base from "../layouts/Base.astro";
import { BLOG, RECOVERY_HREFS } from "../lib/identity";
---
<Base title="Not found" description="This page does not exist." path="/404">
  <section class="lost">
    <p class="lost-code">404</p>
    <h1 class="wordmark">Not<span class="wordmark-dim"> found</span></h1>
    <p>That URL is not on this site. Essays live on the blog.</p>
    <p class="lost-links">
      <a href="/">Home</a>
      <a href={BLOG}>Blog</a>
    </p>
    <ul class="lost-recover">
      {RECOVERY_HREFS.map((href) => (
        <li><a href={href}>{href}</a></li>
      ))}
    </ul>
  </section>
</Base>
