---
import Base from "../layouts/Base.astro";
import {
  BLOG,
  BIO,
  DISPLAY,
  HERO_LEDE,
  HERO_ROLES,
  PATENTS,
  PATENT_FIGURES,
  PERSON,
  PHOTO,
  PHOTO_ALT,
  RESEARCH,
  RESEARCH_FIGURES,
  TALKS,
  WEBSITE,
  WRITING,
} from "../lib/site";

function splitList<T>(items: T[]) {
  const mid = Math.ceil(items.length / 2);
  return [items.slice(0, mid), items.slice(mid)];
}

const patentCols = splitList(PATENTS);
const researchCols = splitList(RESEARCH);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [PERSON, WEBSITE],
};

const roleHrefs: Record<string, string> = {
  "General Partner, Haun Ventures": "https://www.haun.co/team/diogo-monica",
  "Co-founder and Executive Chairman, Anchorage Digital": "https://www.anchorage.com",
};
---
<Base title={DISPLAY} description={BIO} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <img
      class="portrait"
      src={PHOTO}
      alt={PHOTO_ALT}
      width="1200"
      height="1400"
      decoding="async"
    />
    <div>
      <h1 class="wordmark">Diogo<span class="wordmark-dim"> Mónica</span></h1>
      <p class="lede">{HERO_LEDE}</p>
      <p class="bio">
        Previously I led security at Docker and platform security at Square.
        Before joining tech, I spent a while getting a PhD in Computer Science
        at Instituto Superior Técnico. Oh, and I love angel investing.
      </p>
      <ul class="roles">
        {HERO_ROLES.map((role) => (
          <li>
            <a href={roleHrefs[role]}>{role}</a>
          </li>
        ))}
      </ul>
      <p class="identity-links">
        <a href={BLOG}>blog.diogomonica.com</a>
        <a rel="me" href="https://x.com/diogomonica">@diogomonica</a>
        <a rel="me" href="https://www.linkedin.com/in/diogomonica">LinkedIn</a>
        <a rel="me" href="https://en.wikipedia.org/wiki/Diogo_Mónica">Wikipedia</a>
      </p>
    </div>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-heading">
    <h2 id="writing-heading">Latest posts</h2>
    <ul class="link-list">
      {WRITING.map((item) => (
        <li>
          <time datetime={item.date}>{item.label}</time>
          <div>
            <a href={item.href}>{item.title}</a>
            <p>{item.excerpt}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="more" href={BLOG}>All essays on the blog</a>
  </section>

  <section class="section" id="patents" aria-labelledby="patents-heading">
    <h2 id="patents-heading">I build stuff</h2>
    <p>
      I have several patents on payment architectures, payment hardware, private key management, digital asset custody, cryptographic systems, and blockchain.
    </p>
    <ul class="figure-row">
      {PATENT_FIGURES.map((figure) => (
        <li class="figure-card">
          <img
            src={figure.src}
            alt={figure.alt}
            width={figure.width}
            height={figure.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
    <div class="split-list">
      {patentCols.map((col) => (
        <ul class="plain-list">
          {col.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      ))}
    </div>
    <a class="more" href="https://patents.justia.com/search?q=diogo+monica">All patents</a>
  </section>

  <section class="section" id="research" aria-labelledby="research-heading">
    <h2 id="research-heading">I research stuff</h2>
    <p>
      I've published several papers on the topics of security, distributed systems, botnets, intrusion detection systems, quorum systems, and passwords.
    </p>
    <ul class="figure-row">
      {RESEARCH_FIGURES.map((figure) => (
        <li class="figure-card">
          <img
            src={figure.src}
            alt={figure.alt}
            width={figure.width}
            height={figure.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
    <div class="split-list">
      {researchCols.map((col) => (
        <ul class="plain-list">
          {col.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      ))}
    </div>
    <a class="more" href="https://www.researchgate.net/profile/Diogo-Monica">ResearchGate profile</a>
  </section>

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <h2 id="speaking-heading">I talk about stuff</h2>
    <p>
      I speak regularly on the topics of crypto, security, financial regulations, venture capital, startups, and financial literacy.
    </p>
    <ul class="talk-grid">
      {TALKS.map((item) => (
        <li>
          <a class="talk-card" href={item.href}>
            <span class="talk-thumb">
              <img
                src={item.image}
                alt=""
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="talk-title">{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="more" href="https://www.youtube.com/results?search_query=diogo+monica">More talks</a>
  </section>
</Base>
