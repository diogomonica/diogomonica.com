---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import {
  BLOG,
  BIO,
  DISPLAY,
  ORGANIZATIONS,
  PATENTS,
  PATENT_ART,
  PATENT_STILL,
  PERSON,
  PHOTO_ALT,
  PHOTO_IMAGE,
  RESEARCH,
  RESEARCH_ART,
  TALKS,
  WEBSITE,
  WRITING,
} from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [PERSON, WEBSITE, ...ORGANIZATIONS],
};

const orgUrl = (name: string) => ORGANIZATIONS.find((org) => org.name === name)!.url;
const outboundLabel = (title: string, href: string) =>
  `${title}. Opens ${new URL(href).host.replace(/^www\./, "")} in a new tab.`;
---
<Base title={DISPLAY} description={BIO} path="/" jsonLd={jsonLd}>
  <script is:inline slot="head">
    (() => {
      try {
        var stored = sessionStorage.getItem("dm-motion");
        var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (stored === "off" || (stored !== "on" && reduce)) {
          document.documentElement.setAttribute("data-motion", "off");
        }
      } catch (e) {}
    })();
  </script>
  <section class="hero" id="about">
    <div class="hero-copy">
      <div class="identity settle">
        <OptimizedImage
          class="portrait"
          src={PHOTO_IMAGE}
          alt={PHOTO_ALT}
          sizes="(min-width: 1100px) 16rem, (min-width: 720px) 14rem, (min-width: 380px) 12rem, 9.5rem"
          widths={[320, 480, 640, 800, 960]}
          priority
        />
        <h1 class="wordmark">Diogo<br />Mónica</h1>
      </div>
      <p class="lede settle">
        General Partner at <a href={orgUrl("Haun Ventures")}>Haun Ventures</a>,<br />
        Co-founder and Executive Chairman of <a href={orgUrl("Anchorage Digital")}>Anchorage Digital</a>,<br />
        Chairman of the <a href={orgUrl("NEAR Foundation")}>NEAR Foundation</a>,<br />
        and Director at <a href={orgUrl("Erebor")}>Erebor</a>.
      </p>
      <p class="bio settle">
        Previously I led security at Docker and platform security at Square.
        Oh, and I love angel investing.
      </p>
      <button type="button" class="motion-toggle settle" aria-pressed="false">
        <span class="when-playing"><Icon name="pause" /> Pause motion</span>
        <span class="when-paused"><Icon name="play" /> Play motion</span>
      </button>
    </div>
  </section>

  <section class="section chapter posts reveal" id="writing" aria-labelledby="writing-heading">
    <h2 id="writing-heading">I write stuff</h2>
    <ul class="link-list">
      {WRITING.map((item) => (
        <li>
          <time datetime={item.date}>{item.label}</time>
          <div>
            <a href={item.href}>{item.title}</a>
            <p>{item.excerpt}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="more" href={BLOG}>All essays on the blog <Icon name="arrow-right" /></a>
  </section>

  <section class="section chapter reveal" id="patents" aria-labelledby="patents-heading">
    <h2 id="patents-heading">I build stuff</h2>
    <p>
      I have several patents on payment architectures, payment hardware, private key management,
      digital asset custody, cryptographic systems, and blockchain.
    </p>
    <ul class="build-grid">
      {PATENTS.map((item, index) => (
        <li>
          <a class="asset-card" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={outboundLabel(item.title, item.href)}>
            <img
              src={PATENT_ART[index]}
              data-motion-src={PATENT_ART[index]}
              data-still-src={PATENT_STILL[index]}
              alt=""
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <span class="asset-card-body">
              <span class="asset-card-title">{item.title}</span>
              <span class="asset-card-go" aria-hidden="true">
                <Icon name="arrow-up-right" />
                <span class="sr-only">↗</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a class="more" href="https://patents.justia.com/search?q=diogo+monica" target="_blank" rel="noopener noreferrer">All patents <Icon name="arrow-up-right" /></a>
  </section>

  <section class="section chapter reveal" id="research" aria-labelledby="research-heading">
    <h2 id="research-heading">I research stuff</h2>
    <p>
      I've published several papers on the topics of security, distributed systems, botnets,
      intrusion detection systems, quorum systems, and passwords.
    </p>
    <ul class="research-grid">
      {RESEARCH.map((item, index) => (
        <li>
          <a class="asset-card" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={outboundLabel(item.title, item.href)}>
            {RESEARCH_ART[index] && (
              <img src={RESEARCH_ART[index]} alt="" width="640" height="480" loading="lazy" decoding="async" />
            )}
            <span class="asset-card-body">
              <span class="asset-card-title">{item.title}</span>
              <span class="asset-card-go" aria-hidden="true">
                <Icon name="arrow-up-right" />
                <span class="sr-only">↗</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a class="more" href="https://www.researchgate.net/profile/Diogo-Monica" target="_blank" rel="noopener noreferrer">ResearchGate profile <Icon name="arrow-up-right" /></a>
  </section>

  <section class="section chapter reveal" id="speaking" aria-labelledby="speaking-heading">
    <h2 id="speaking-heading">I talk about stuff</h2>
    <p>
      I speak regularly on the topics of crypto, security, financial regulations,
      venture capital, startups, and financial literacy.
    </p>
    <ul class="talk-grid">
      {TALKS.map((item) => (
        <li>
          <a href={item.href} rel="noopener noreferrer">
            <OptimizedImage
              src={item.image}
              alt=""
              sizes="(min-width: 900px) calc((min(1120px, 100vw - 4rem) - 2rem) / 3), (min-width: 720px) calc((100vw - 4rem - 1rem) / 2), calc(100vw - 2rem)"
              widths={[480, 720, 960, 1280]}
            />
            <span>{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="more" href="https://www.youtube.com/results?search_query=diogo+monica">More talks <Icon name="arrow-right" /></a>
  </section>
  <script is:inline>
    (() => {
      var nodes = document.querySelectorAll("[data-motion-src]");
      var button = document.querySelector(".motion-toggle");
      function apply(paused, persist) {
        for (var i = 0; i < nodes.length; i++) {
          var node = nodes[i];
          var next = paused ? node.getAttribute("data-still-src") : node.getAttribute("data-motion-src");
          if (next && node.getAttribute("src") !== next) node.setAttribute("src", next);
        }
        document.documentElement.setAttribute("data-motion", paused ? "off" : "on");
        if (button) button.setAttribute("aria-pressed", paused ? "true" : "false");
        if (persist) {
          try { sessionStorage.setItem("dm-motion", paused ? "off" : "on"); } catch (e) {}
        }
      }
      apply(document.documentElement.getAttribute("data-motion") === "off", false);
      if (button) {
        button.addEventListener("click", function () {
          apply(document.documentElement.getAttribute("data-motion") !== "off", true);
        });
      }
    })();
  </script>
</Base>
