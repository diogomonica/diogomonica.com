---
import Base from "../layouts/Base.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import {
  BLOG,
  BIO,
  DISPLAY,
  HERO_LEDE,
  HERO_ROLES,
  PATENTS,
  PERSON,
  PHOTO_ALT,
  PHOTO_IMAGE,
  PATENT_FIGURES,
  RESEARCH,
  RESEARCH_FIGURES,
  ROLES,
  TALKS,
  WEBSITE,
  WRITING,
} from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [PERSON, WEBSITE],
};

const roleHrefs: Record<string, string> = {
  "General Partner, Haun Ventures": "https://www.haun.co/team/diogo-monica",
  "Co-founder and Executive Chairman, Anchorage Digital": "https://www.anchorage.com",
  "Chairman, NEAR Foundation": "https://near.foundation",
  "Director, Erebor": "https://www.haun.co/writing/erebor",
};
---
<Base title={DISPLAY} description={BIO} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <OptimizedImage
      class="portrait"
      src={PHOTO_IMAGE}
      alt={PHOTO_ALT}
      sizes="(min-width: 800px) 15.5rem, min(16rem, calc(100vw - 2rem))"
      priority
    />
    <div>
      <h1 class="wordmark">Diogo<span class="wordmark-dim"> Mónica</span></h1>
      <p class="lede">{HERO_LEDE}</p>
      <p class="bio">
        Previously I led security at Docker and platform security at Square.
        Before joining tech, I spent a while getting a PhD in Computer Science
        at Instituto Superior Técnico. Oh, and I love angel investing.
      </p>
      <ul class="roles">
        {HERO_ROLES.map((role) => (
          <li>
            <a href={roleHrefs[role]}>{role}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <section class="section" id="writing" aria-labelledby="writing-heading">
    <h2 id="writing-heading">Latest posts</h2>
    <ul class="link-list">
      {WRITING.map((item) => (
        <li>
          <time datetime={item.date}>{item.label}</time>
          <div>
            <a href={item.href}>{item.title}</a>
            <p>{item.excerpt}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="more" href={BLOG}>All essays on the blog</a>
  </section>

  <section class="section" id="patents" aria-labelledby="patents-heading">
    <h2 id="patents-heading">I build stuff</h2>
    <p>
      I have several patents on payment architectures, payment hardware, private key management,
      digital asset custody, cryptographic systems, and blockchain.
    </p>
    <ul class="figure-row" aria-hidden="true">
      {PATENT_FIGURES.map((item) => (
        <li>
          <OptimizedImage src={item.src} alt="" sizes="(min-width: 800px) 168px, calc(50vw - 1.5rem)" />
        </li>
      ))}
    </ul>
    <ul class="plain-list cols">
      {PATENTS.map((item) => (
        <li><a href={item.href}>{item.title}</a></li>
      ))}
    </ul>
    <a class="more" href="https://patents.justia.com/search?q=diogo+monica">All patents</a>
  </section>

  <section class="section" id="research" aria-labelledby="research-heading">
    <h2 id="research-heading">I research stuff</h2>
    <p>
      I've published several papers on the topics of security, distributed systems, botnets,
      intrusion detection systems, quorum systems, and passwords.
    </p>
    <ul class="figure-row" aria-hidden="true">
      {RESEARCH_FIGURES.map((item) => (
        <li>
          <OptimizedImage src={item.src} alt="" sizes="(min-width: 800px) 168px, calc(50vw - 1.5rem)" />
        </li>
      ))}
    </ul>
    <ul class="plain-list cols">
      {RESEARCH.map((item) => (
        <li><a href={item.href}>{item.title}</a></li>
      ))}
    </ul>
    <a class="more" href="https://www.researchgate.net/profile/Diogo-Monica">ResearchGate profile</a>
  </section>

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <h2 id="speaking-heading">I talk about stuff</h2>
    <p>
      I speak regularly on the topics of crypto, security, financial regulations,
      venture capital, startups, and financial literacy.
    </p>
    <ul class="talk-grid">
      {TALKS.map((item) => (
        <li>
          <a href={item.href} rel="noopener noreferrer">
            <OptimizedImage src={item.image} alt="" sizes="(min-width: 800px) 280px, min(880px, calc(100vw - 2rem))" />
            <span>{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="more" href="https://www.youtube.com/results?search_query=diogo+monica">More talks</a>
  </section>

</Base>
