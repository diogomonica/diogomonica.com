---
import { LINKEDIN_URL, WIKIPEDIA_URL, X_URL } from "../lib/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const links = [
  {
    href: WIKIPEDIA_URL,
    label: "Wikipedia",
    path: "M3.2 5h2.1l2.15 8.4L9.8 5h2.05l2.4 8.4L16.4 5h2.1L15.2 19h-2.15L10.8 10.2 8.55 19H6.4L3.2 5z",
  },
  {
    href: LINKEDIN_URL,
    label: "LinkedIn",
    path: "M5.7 9.2H3.4V20h2.3V9.2zM4.55 4c-.75 0-1.35.62-1.35 1.4S3.8 6.8 4.55 6.8 5.9 6.18 5.9 5.4 5.3 4 4.55 4zM20.6 20h-2.3v-5.2c0-1.48-.53-2.5-1.86-2.5-.98 0-1.56.66-1.82 1.3-.09.22-.11.53-.11.84V20h-2.3s.03-9.3 0-10.3h2.3v1.46c.31-.48 1.2-1.62 2.92-1.62 2.13 0 3.73 1.4 3.73 4.4V20z",
  },
  {
    href: X_URL,
    label: "X",
    path: "M5 5.9 10.05 12 5 18.1h2.15L12 13.45l4.85 4.65H19L13.95 12 19 5.9h-2.15L12 10.55 7.15 5.9H5z",
  },
] as const;
---
<nav class:list={["identity-pills", className]} aria-label="Profiles">
  {links.map((link) => (
    <a href={link.href} target="_blank" rel="me noopener" aria-label={link.label} title={link.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={link.path} />
      </svg>
    </a>
  ))}
</nav>
