---
import "../styles/global.css";
import BrandMark from "../components/BrandMark.astro";
import { BLOG, BIO, DISPLAY, PHOTO, SAME_AS, SITE } from "../lib/site";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object;
}

const { title, description, path, jsonLd } = Astro.props;
const url = new URL(path, SITE).href;
const ogImage = new URL(PHOTO, SITE).href;
const pageTitle = path === "/" ? `${DISPLAY} — ${BIO}` : `${title} · ${DISPLAY}`;

const navItems = [
  { href: "/", label: "Home", current: path === "/" },
  { href: "/about", label: "About", current: path === "/about" },
  { href: BLOG, label: "Blog", current: false },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#ffffff" />
  <style is:inline>
    html{background:#fff;color:#1f2428;color-scheme:only light}
  </style>
  <script is:inline>
    document.documentElement.classList.add("js");
  </script>
  <slot name="head" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={DISPLAY} />
  <link rel="canonical" href={url} />
  <link rel="preload" href="/fonts/EBGaramond-Roman-VF.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/fonts/IMFellEnglish-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:site_name" content={DISPLAY} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="Portrait of Diogo Mónica" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@diogomonica" />
  <meta name="twitter:creator" content="@diogomonica" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="Portrait of Diogo Mónica" />
  {SAME_AS.map((href) => <link rel="me" href={href} />)}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="topline" aria-hidden="true"></div>
  <header class="site-header" id="top">
    <nav class="top-nav" id="mobile-nav" aria-label="Site">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </header>
  <nav class="rail" aria-label="Sections">
    <div class="rail-track" aria-hidden="true"></div>
    <div class="rail-fill" aria-hidden="true"></div>
  </nav>
  <main id="main"><slot /></main>
  {path !== "/" && (
    <footer class="site-footer">
      <div class="mid">
        <span class="footer-brand">
          <BrandMark class="footer-mark" />
          <span>© {DISPLAY}</span>
        </span>
        <nav aria-label="Identity">
          <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>
          <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
          <a href="/privacy" aria-current={path === "/privacy" ? "page" : undefined}>Privacy</a>
          <a href={BLOG}>Blog</a>
          <a rel="me" href="https://x.com/diogomonica">@diogomonica</a>
          <a rel="me" href="https://www.linkedin.com/in/diogomonica">LinkedIn</a>
          <a rel="me" href="https://en.wikipedia.org/wiki/Diogo_Mónica">Wikipedia</a>
          <a rel="me" href="https://www.wikidata.org/wiki/Q111948997">Wikidata</a>
          <a rel="me" href="https://www.haun.co/team/diogo-monica">Haun</a>
        </nav>
      </div>
    </footer>
  )}
  <script is:inline>
    (() => {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var nodes = Array.prototype.slice.call(document.querySelectorAll(".reveal"));
      var root = document.documentElement;
      var ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
      var LINE = 0.285;
      var rail = document.querySelector(".rail");
      var wide = window.matchMedia("(min-width: 1100px)");
      var chapters = Array.prototype.slice.call(document.querySelectorAll("section.ch"));
      var stops = [];
      var ticking = false;
      var lastP = -1;

      function show(el, animate) {
        if (el.classList.contains("is-in")) return;
        el.classList.add("is-in");
        if (!animate || reduce) el.classList.add("no-anim");
      }
      function settle(el) {
        el.classList.add("is-in", "no-anim");
      }
      function revealAll() {
        for (var i = 0; i < nodes.length; i++) show(nodes[i], false);
      }
      window.addEventListener("load", function () { window.setTimeout(revealAll, 1200); });
      window.setTimeout(revealAll, 2500);
      window.setTimeout(function () {
        document.querySelectorAll(".hero .l, .ih-title").forEach(function (el) { el.style.opacity = "1"; });
        document.querySelectorAll(".i").forEach(function (el) {
          el.style.animation = "none";
          el.style.webkitClipPath = "none";
          el.style.clipPath = "none";
        });
      }, 3200);

      if (reduce || !("IntersectionObserver" in window)) {
        revealAll();
      } else {
        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            show(entries[i].target, true);
            io.unobserve(entries[i].target);
          }
        }, { threshold: 0, rootMargin: "0px 0px 15% 0px" });
        for (var n = 0; n < nodes.length; n++) io.observe(nodes[n]);
      }

      function scan() {
        var vh = window.innerHeight || 800;
        var margin = vh * 0.15;
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          if (el.classList.contains("is-in")) continue;
          var r = el.getBoundingClientRect();
          if (r.bottom < 8) settle(el);
          else if (!el.classList.contains("is-in") && r.top < vh + margin) show(el, true);
        }
      }

      if (rail && chapters.length) {
        chapters.forEach(function (ch, i) {
          if (!ch.id) return;
          var label = ch.getAttribute("data-rail") || "";
          var numeral = ROMAN[i] || String(i + 1);
          var a = document.createElement("a");
          a.className = "stop";
          a.href = "#" + ch.id;
          var num = document.createElement("span");
          num.className = "stop-n";
          num.textContent = numeral;
          var tip = document.createElement("span");
          tip.className = "stop-t";
          var b = document.createElement("b");
          b.textContent = numeral;
          tip.appendChild(b);
          tip.appendChild(document.createTextNode(label));
          a.appendChild(num);
          a.appendChild(tip);
          a.setAttribute("aria-label", numeral + (label ? " " + label : ""));
          rail.appendChild(a);
          stops.push(a);
        });
      }

      function topOf(el) { return el.getBoundingClientRect().top + window.scrollY; }
      function measure() {
        var docEnd = Math.max(1, root.scrollHeight - window.innerHeight);
        var p = Math.min(1, Math.max(0, window.scrollY / docEnd));
        if (Math.abs(p - lastP) > 0.0004) {
          root.style.setProperty("--p", p.toFixed(4));
          lastP = p;
        }
        if (!chapters.length) return;
        var start = topOf(chapters[0]) - window.innerHeight * LINE;
        var cur = 0;
        chapters.forEach(function (c, i) {
          if (c.getBoundingClientRect().top < window.innerHeight * LINE) cur = i;
        });
        if (wide.matches) {
          stops.forEach(function (s, i) {
            var y = (topOf(chapters[i]) - window.innerHeight * LINE) / docEnd;
            s.style.top = (Math.min(1, Math.max(0, y)) * 100).toFixed(3) + "%";
            s.classList.toggle("past", i < cur);
            s.classList.toggle("on", i === cur);
            if (i === cur) s.setAttribute("aria-current", "location");
            else s.removeAttribute("aria-current");
          });
          if (rail) rail.classList.toggle("on", window.scrollY > start);
        }
      }

      function frame() {
        ticking = false;
        measure();
        scan();
      }
      window.addEventListener("scroll", function () {
        if (!ticking) { ticking = true; window.requestAnimationFrame(frame); }
      }, { passive: true });
      window.addEventListener("resize", function () { window.requestAnimationFrame(frame); });
      frame();
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () {
          window.requestAnimationFrame(function () { window.requestAnimationFrame(frame); });
        });
      }

      var from = document.querySelector("[data-resume]");
      var KEY = "dm-place";
      try {
        var saved = JSON.parse(localStorage.getItem(KEY) || "null");
        if (from && saved && saved.id) {
          var target = document.getElementById(saved.id);
          var section = target && target.closest ? target.closest("section.ch") : null;
          var label = section && section.getAttribute("data-rail");
          if (label) from.textContent = "from " + label;
        }
      } catch (err) { /* storage unavailable */ }
      var saveT = 0;
      window.addEventListener("scroll", function () {
        window.clearTimeout(saveT);
        saveT = window.setTimeout(function () {
          var marks = Array.prototype.slice.call(document.querySelectorAll(".prose p[id], .toc-item[id]"));
          var found = null;
          for (var i = marks.length - 1; i >= 0; i--) {
            if (marks[i].getBoundingClientRect().top < window.innerHeight * LINE) { found = marks[i]; break; }
          }
          if (!found) return;
          try {
            localStorage.setItem(KEY, JSON.stringify({
              id: found.id,
              dy: Math.round(found.getBoundingClientRect().top),
              t: Date.now(),
            }));
          } catch (err) { /* ignore */ }
        }, 1500);
      }, { passive: true });

      document.addEventListener("click", function (event) {
        var ref = event.target.closest ? event.target.closest(".nref") : null;
        if (!ref || wide.matches) return;
        event.preventDefault();
        var host = ref.closest("p") || ref.parentElement;
        var open = host && host.nextElementSibling && host.nextElementSibling.classList.contains("nbox") && host.nextElementSibling.dataset.for === ref.hash;
        document.querySelectorAll(".nbox").forEach(function (b) { b.remove(); });
        document.querySelectorAll(".nref[aria-expanded]").forEach(function (r) { r.setAttribute("aria-expanded", "false"); });
        if (open || !host) return;
        var source = document.querySelector(ref.hash);
        if (!source) return;
        var box = document.createElement("div");
        box.className = "nbox";
        box.dataset.for = ref.hash;
        box.innerHTML = source.innerHTML;
        host.after(box);
        ref.setAttribute("aria-expanded", "true");
      });

      function placeNotes() {
        if (!wide.matches) return;
        chapters.forEach(function (ch) {
          var floor = 0;
          var base = ch.getBoundingClientRect().top;
          ch.querySelectorAll(".nref").forEach(function (ref) {
            if (!ref.hash) return;
            var note = document.getElementById(ref.hash.slice(1));
            if (!note) return;
            var y = Math.max(ref.getBoundingClientRect().top - base - 4, floor);
            note.style.top = y + "px";
            floor = y + note.offsetHeight + 14;
          });
        });
      }
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(placeNotes);
      window.addEventListener("resize", placeNotes);
    })();
  </script>
</body>
</html>
